# Storage
DATABASE_URL=postgresql+psycopg://autopsy:autopsy@localhost:5432/autopsy
REDIS_URL=redis://localhost:6379/0

# HTTP
CORS_ORIGINS=http://localhost:3000
ALLOW_ANONYMOUS_DEMO_TENANT=true

# AI layer: "offline" needs nothing; "openai_compatible" talks to any
# OpenAI-style /chat/completions endpoint (hosted gateway, vLLM, Ollama, ...).
AI_PROVIDER=offline
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=local-model
AI_REDACT_PII=true

# Demo
SEED_DEMO_ON_STARTUP=true
DEMO_RANDOM_SEED=20260830
